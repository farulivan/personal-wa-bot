# personal-wa-bot environment template
# Copy this file to .env, then fill required values.

# =========================
# Required / strongly advised
# =========================

# PostgreSQL connection URL.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated phone numbers that are allowed to use bot commands.
# Use international format, digits only (no +, spaces, or punctuation).
# Example: 6281234567890,6289876543210
ALLOWED_NUMBERS=

# WhatsApp group IDs used for scheduled digests and prayer-reminder opt-in.
# Comma-separated; each scheduled digest is sent to every listed group.
# Format: 120363xxxxx@g.us,120363yyyyy@g.us
# If empty, the digest scheduler is disabled.
DIGEST_GROUP_IDS=

# Enable debug logs: true/false (or 1/0)
DEBUG=false

# =========================
# Time and scheduling
# =========================

# User timezone offset in minutes from UTC.
# UTC+7 (WIB) = 420
# UTC+8 (WITA) = 480
# UTC+9 (WIT) = 540
USER_TIMEZONE_OFFSET_MINUTES=420

# Daily workout digest schedule (in USER_TIMEZONE_OFFSET_MINUTES timezone)
# 24-hour format
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0

# Monthly recap digest schedule — fires on day 1 of each month (in USER_TIMEZONE_OFFSET_MINUTES timezone)
# Sends last month's Workout and Quran leaderboard to each group in DIGEST_GROUP_IDS
# 24-hour format
MONTHLY_DIGEST_HOUR=8
MONTHLY_DIGEST_MINUTE=0

# Daily Quran reminder schedule (in USER_TIMEZONE_OFFSET_MINUTES timezone)
# 24-hour format
QURAN_REMINDER_HOUR=22
QURAN_REMINDER_MINUTE=0

# =========================
# Feature behavior
# =========================

# Minimum workouts in one day to count as 1 streak day
MIN_WORKOUTS_FOR_STREAK=3

# Pagination size for #workout --list
WORKOUT_LIST_LIMIT=10

# Pagination size for #quran --list
QURAN_LIST_LIMIT=10

# Temporary Ramadhan pages counter in #quran --list
# Default OFF. Set true to show Ramadhan total pages section.
QURAN_RAMADHAN_COUNT_ENABLED=false

# Ramadhan local date range for counter (inclusive, YYYY-MM-DD)
# Example: 2026-02-18 to 2026-03-19
QURAN_RAMADHAN_START_DATE=
QURAN_RAMADHAN_END_DATE=

# Default sholat location if user does not provide --location
SHOLAT_DEFAULT_LOCATION=KAB. BOGOR

# IANA timezone for sholat API date calculation
# Example: Asia/Jakarta
SHOLAT_TIMEZONE=Asia/Jakarta

# Prayer-time reminders are opt-in per chat (#sholat reminder on) and reuse the settings
# above — no extra config. In groups, only groups listed in DIGEST_GROUP_IDS may enable them; DMs are self-serve.

# =========================
# Runtime / deployment options (optional)
# =========================

# Override Chromium executable path if required by hosting environment
# Example: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# Override LocalAuth data directory (used in some cloud environments)
# Example: /data
RAILWAY_VOLUME_MOUNT_PATH=

# Pagination size for #remind --list
REMIND_LIST_LIMIT=10

# Maximum active (unsent) reminders per user
REMIND_ACTIVE_LIMIT=50

# =========================
# Testing (optional)
# =========================

# PostgreSQL URL for integration tests (separate from production!)
# Example: postgresql://wabot:wabot@localhost:5432/wabot_test
TEST_DATABASE_URL=
