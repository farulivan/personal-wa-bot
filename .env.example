# personal-wa-bot environment template
# Copy this file to .env, then fill required values.

# =========================
# Required / strongly advised
# =========================

# Comma-separated phone numbers that are allowed to use bot commands.
# Use international format, digits only (no +, spaces, or punctuation).
# Example: 6281234567890,6289876543210
ALLOWED_NUMBERS=

# WhatsApp group ID used for scheduled digests/reminders.
# Format: 120363xxxxx@g.us
# If empty, scheduler is disabled.
DIGEST_GROUP_ID=

# Enable debug logs: true/false (or 1/0)
DEBUG=false

# =========================
# Time and scheduling
# =========================

# User timezone offset in minutes from UTC.
# UTC+7 (WIB) = 420
# UTC+8 (WITA) = 480
# UTC+9 (WIT) = 540
USER_TIMEZONE_OFFSET_MINUTES=420

# Daily workout digest schedule (in USER_TIMEZONE_OFFSET_MINUTES timezone)
# 24-hour format
DAILY_DIGEST_HOUR=8
DAILY_DIGEST_MINUTE=0

# Daily Quran reminder schedule (in USER_TIMEZONE_OFFSET_MINUTES timezone)
# 24-hour format
QURAN_REMINDER_HOUR=22
QURAN_REMINDER_MINUTE=0

# =========================
# Feature behavior
# =========================

# Minimum workouts in one day to count as 1 streak day
MIN_WORKOUTS_FOR_STREAK=3

# Pagination size for #workout --list
WORKOUT_LIST_LIMIT=10

# Pagination size for #quran --list
QURAN_LIST_LIMIT=10

# Default sholat location if user does not provide --location
SHOLAT_DEFAULT_LOCATION=KAB. BOGOR

# IANA timezone for sholat API date calculation
# Example: Asia/Jakarta
SHOLAT_TIMEZONE=Asia/Jakarta

# =========================
# Runtime / deployment options (optional)
# =========================

# Override Chromium executable path if required by hosting environment
# Example: /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# Override LocalAuth data directory (used in some cloud environments)
# Example: /data
RAILWAY_VOLUME_MOUNT_PATH=
