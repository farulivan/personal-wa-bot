# WhatsApp Bot Configuration
# Copy this file to .env and fill in your values

# Comma-separated list of phone numbers allowed to use the bot
# Format: country code + number, no spaces or symbols
# Example: 6281234567890,6289876543210
ALLOWED_NUMBERS=

# WhatsApp group chat ID for daily streak digest
# Send any message in the group and check logs for the ID
# Format: 120363xxxxx@g.us
DIGEST_GROUP_ID=

# Flag for debugging (boolean)
DEBUG=
